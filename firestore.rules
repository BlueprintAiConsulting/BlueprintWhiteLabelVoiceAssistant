rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email == "drewhufnagle@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    match /users/{userId} {
      allow read, write: if isAdmin() && request.auth.uid == userId;
    }

    match /settings/{document} {
      allow read, write: if isAdmin();
    }

    match /leads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /learning_proposals/{proposalId} {
      allow read, write: if isAdmin();
    }

    match /call_telemetry/{telemetryId} {
      allow read, write: if isAdmin();
    }

    match /test/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
